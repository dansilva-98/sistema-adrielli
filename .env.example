# Runtime local: papel app_runtime. Em produção, use o pooler em modo transação (porta 6543)
# com a senha definida pela responsável, fora do repositório.
DATABASE_URL=postgresql://app_runtime:app-runtime-local@127.0.0.1:54322/postgres
# Dono das migrations. A aplicação em execução não lê esta variável.
# Local: conexão direta (porta 54322). Staging e produção: Session pooler, porta 5432.
MIGRATIONS_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
TEST_DATABASE_URL=postgresql://app_runtime:app-runtime-local@127.0.0.1:54322/adrielli_flores_test
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=substitua-pela-chave-anon-local
SUPABASE_SERVICE_ROLE_KEY=substitua-pela-chave-service-role
SENTRY_DSN=https://public@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://public@o0.ingest.sentry.io/0
APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Segredo local da sessão da equipe. Em staging e produção, defina outro valor fora do repositório.
STAFF_SESSION_SECRET=local-staff-session-secret-32chars
